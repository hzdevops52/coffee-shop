.hero{padding-top:155px;padding-bottom:82px;isolation:isolate}
.hero-copy{width:min(53%,680px);margin-top:28px;flex-shrink:0}
.hero h1{max-width:690px;font-size:clamp(58px,6.8vw,98px);line-height:.98;overflow-wrap:normal}
.hero-description{max-width:410px}
.hero-object-wrap{right:3%;top:14%;width:49%;height:75%;overflow:visible}
#coffee-canvas{width:100%;height:100%;min-width:0;min-height:0;overflow:visible}
.cup-caption{bottom:3%;white-space:nowrap}
.menu-item{grid-template-columns:42px minmax(0,1fr) auto auto;gap:18px}
.menu-item-action{border:1px solid rgba(214,164,107,.55);background:transparent;color:var(--gold);padding:10px 14px;font:600 8px var(--sans);letter-spacing:1.25px;white-space:nowrap;cursor:pointer;transition:background .25s,color .25s,transform .25s,border-color .25s}
.menu-item-action:hover{background:var(--gold);color:var(--espresso);border-color:var(--gold);transform:translateY(-2px)}
.menu-item-action:active{transform:translateY(0) scale(.97)}
.menu-item-action.added{background:rgba(214,164,107,.12)}
/* Cart drawer */
.cart-trigger{position:fixed;right:28px;bottom:28px;z-index:160;display:flex;align-items:center;gap:12px;padding:14px 18px;border:1px solid rgba(214,164,107,.65);background:rgba(23,17,14,.94);backdrop-filter:blur(14px);color:var(--ivory);font:600 9px var(--sans);letter-spacing:1.3px;cursor:pointer;box-shadow:0 12px 35px #0005;transition:transform .25s,background .25s}
.cart-trigger:hover{transform:translateY(-3px);background:#302019}
.cart-trigger-icon{color:var(--gold);font-size:17px}
.cart-count{display:grid;place-items:center;min-width:21px;height:21px;padding:0 5px;border-radius:50%;background:var(--gold);color:var(--espresso);font-size:9px;letter-spacing:0}
.cart-overlay{position:fixed;inset:0;z-index:190;background:rgba(8,5,3,.68);opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
.cart-overlay.open{opacity:1;visibility:visible}
.cart-drawer{position:absolute;top:0;right:0;width:min(470px,100%);height:100%;display:flex;flex-direction:column;padding:30px clamp(22px,4vw,38px);background:#211711;border-left:1px solid var(--line);transform:translateX(102%);transition:transform .38s cubic-bezier(.2,.7,.2,1)}
.cart-overlay.open .cart-drawer{transform:translateX(0)}
.cart-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:22px;border-bottom:1px solid var(--line)}
.cart-head h2{font:500 34px var(--serif);margin:0;color:var(--ivory)}
.cart-close{border:0;background:none;color:var(--gold);font-size:30px;cursor:pointer;padding:4px 8px}
.cart-items{flex:1;overflow:auto;padding:10px 0}
.cart-empty{padding:50px 0;text-align:center;color:#a99888;font:italic 20px var(--serif)}
.cart-line{display:grid;grid-template-columns:1fr auto;gap:14px;padding:18px 0;border-bottom:1px solid rgba(214,164,107,.13)}
.cart-line h3{font-size:22px;margin:0 0 4px;color:var(--ivory)}
.cart-line small{font-size:8px;letter-spacing:1px;color:#a99888}
.cart-quantity{display:flex;align-items:center;gap:10px}
.cart-quantity button{width:27px;height:27px;border:1px solid var(--line);background:transparent;color:var(--gold);cursor:pointer}
.cart-quantity span{min-width:14px;text-align:center;font-size:12px}
.cart-remove{display:block;margin-top:8px;border:0;background:none;color:#ad8970;text-decoration:underline;font-size:9px;cursor:pointer}
.cart-foot{border-top:1px solid var(--line);padding-top:20px}
.cart-note{font-size:10px;line-height:1.6;color:#a99888;margin-bottom:16px}
.cart-checkout{width:100%;border:0;cursor:pointer}
.cart-checkout:disabled{opacity:.4;cursor:not-allowed}
.cart-toast{position:fixed;left:50%;bottom:30px;z-index:220;transform:translate(-50%,20px);padding:12px 18px;background:#302019;border:1px solid var(--gold);color:var(--ivory);font-size:10px;letter-spacing:.5px;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s}
.cart-toast.show{opacity:1;transform:translate(-50%,0)}
body.cart-open{overflow:hidden}
@media(max-width:1100px){.site-header{padding-inline:3.5%;gap:12px}.brand{flex-basis:145px}.brand-logo{width:145px}.desktop-nav{gap:12px}.nav-link{font-size:8px}.header-cta{padding:12px 13px;font-size:8px}.hero{padding-left:7%;padding-right:7%}.hero-copy{width:54%}.hero-object-wrap{right:0;width:49%}}
@media(max-width:800px){.site-header,.site-header.scrolled{padding-inline:6%;gap:0}.hero{padding-top:112px;padding-bottom:65px;min-height:820px;height:auto;max-height:none;align-items:flex-start}.hero-copy{width:100%;max-width:640px;margin-top:8px;z-index:4}.hero h1{font-size:clamp(52px,10vw,78px);max-width:600px}.hero-object-wrap{top:auto;bottom:5%;right:-4%;width:72%;height:46%;opacity:1;z-index:2}.hero-object-wrap:before{width:min(65vw,390px)}.cup-caption{bottom:1%;font-size:7px}.hero-bottom-note{margin-top:30px}.menu-item{grid-template-columns:28px minmax(0,1fr) auto;gap:10px}.menu-price{grid-column:2;grid-row:2;margin-top:4px}.menu-item-action{grid-column:3;grid-row:1 / span 2;padding:10px 11px}.cart-trigger{right:16px;bottom:16px;padding:12px 14px}.cart-toast{bottom:82px}}
@media(max-width:520px){.hero{min-height:790px;padding-top:105px}.hero-copy{margin-top:0}.hero h1{font-size:clamp(48px,11.5vw,62px);line-height:1}.hero-description{max-width:310px}.hero-object-wrap{bottom:4%;right:-8%;width:90%;height:39%;opacity:1}.cup-caption{bottom:0;font-size:6px;gap:8px}.hero-bottom-note{font-size:7px}.menu-item{padding:17px 0}.menu-item h3{font-size:21px}.menu-item-action{font-size:7px;padding:9px 8px}.cart-trigger{right:12px;bottom:12px}.cart-trigger-label{display:none}.cart-drawer{padding:24px 20px}}
@media(max-width:370px){.hero h1{font-size:45px}.hero-object-wrap{width:100%;right:-13%}.menu-item-action{letter-spacing:.5px}}
.no-webgl .hero-object-wrap:after,.no-3d .hero-object-wrap:after{content:"";position:relative;display:block;width:clamp(190px,24vw,310px);height:clamp(150px,18vw,230px);border-radius:12% 12% 34% 34% / 12% 12% 22% 22%;background:linear-gradient(105deg,#9b8068 0%,#eee0ce 24%,#bda58d 52%,#f2e7d8 78%,#8b6a50 100%);box-shadow:inset -18px -14px 30px #38251c88,0 30px 55px #0008;transform:perspective(600px) rotate(-8deg);}
.no-webgl .hero-object-wrap:before,.no-3d .hero-object-wrap:before{width:clamp(220px,30vw,370px);}
.no-webgl .hero-object-wrap:after,.no-3d .hero-object-wrap:after{outline:8px solid transparent;}
